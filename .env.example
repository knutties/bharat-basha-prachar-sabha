# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgres://bbps:bbps_dev_password@localhost:5432/bbps_auth

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string

# ─── Logging ────────────────────────────────────────────────────
RUST_LOG=info,tower_http=debug

# ─── Service Ports ──────────────────────────────────────────────
# auth-service:         8001
# curriculum-service:   8002
# assessment-service:   8003
# content-service:      8004
# live-class-service:   8005
# notification-service: 8006
# payment-service:      8007
# ai-ml-service:        8010
PORT=8001

# ─── Razorpay (payment-service only) ───────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
